{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions"],
  "rangeStrategy": "update-lockfile",
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Review external non-major updates together.",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "external dependencies (non-major)"
    },
    {
      "description": "Keep published consumer compatibility ranges under manual control.",
      "matchManagers": ["npm"],
      "matchDepTypes": ["peerDependencies", "engines"],
      "enabled": false
    }
  ]
}
