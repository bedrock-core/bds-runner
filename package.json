{
	"name": "@bedrock-core/bds-runner",
	"version": "0.0.0",
	"description": "Runs Minecraft GameTests headlessly on a Bedrock Dedicated Server and reports a CI exit code",
	"keywords": [
		"minecraft",
		"bedrock",
		"bds",
		"bedrock-dedicated-server",
		"gametest",
		"testing",
		"ci"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bedrock-core/bds-runner.git"
	},
	"type": "module",
	"types": "src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		}
	},
	"bin": {
		"bc-bds": "./bin/bc-bds.mjs"
	},
	"sideEffects": false,
	"files": [
		"src/**/*",
		"bin/**/*",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"build": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"fetch": "node bin/bc-bds.mjs fetch",
		"where": "node bin/bc-bds.mjs where",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "yarn lint && yarn typecheck && yarn test && node scripts/publish-tarballs.mjs && changeset tag",
		"clean": "node scripts/clean.mjs"
	},
	"dependencies": {
		"jiti": "^2.7.0",
		"prismarine-nbt": "^2.7.0",
		"yauzl": "^3.2.0"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.7.0",
		"@changesets/cli": "^2.31.0",
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/node": "^26.2.0",
		"@types/yauzl": "^2.10.3",
		"@vitest/coverage-v8": "^4.1.10",
		"eslint": "^10.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vitest": "^4.1.10"
	},
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"bugs": {
		"url": "https://github.com/bedrock-core/bds-runner/issues"
	},
	"homepage": "https://github.com/bedrock-core/bds-runner#readme",
	"packageManager": "yarn@4.18.0"
}
